    <!-- Terminal font size (Connections/Settings screen) -->
    <string name="terminal_font_size_title">Terminal font size</string>
    <string name="terminal_wheel_scrolling_title">Smooth scrolling in full-screen panes</string>
    <string name="terminal_wheel_scrolling_on_help">Swipes scroll a fraction of a line at a time, so the pane follows your finger. Each notch is a round trip to the host, so on a slow link it can lag behind.</string>
    <string name="terminal_wheel_scrolling_off_help">Swipes send Page Up / Page Down instead. One keystroke jumps half a screen: much faster over a slow link, but it moves in steps rather than smoothly.</string>
    <string name="terminal_poll_title">Check for new output every</string>
    <string name="terminal_poll_millis">%1$d ms</string>
    <string name="terminal_poll_seconds">%1$d s</string>
    <string name="terminal_poll_wifi_label">On Wi-Fi</string>
    <string name="terminal_poll_mobile_label">On mobile data</string>
    <string name="terminal_poll_help">How often the host is checked for output you did not type. Checking less often uses proportionally less data on a busy pane, and costs nothing either way while a pane is idle. Typing and pasting are answered immediately at every setting. A Wi-Fi hotspot you have marked as metered counts as mobile data.</string>
    <string name="terminal_font_size_reset">Reset to fit</string>
    <string name="terminal_font_size_help">100% fits the terminal\'s full width on screen; higher zooms in. Pinching inside a terminal changes the same setting.</string>
    <string name="connections_intro_title">Connect this phone to a host</string>
    <string name="connections_intro_body">Run “term-bridge agent” on the machine you want to reach, then pair below by scanning the QR code it prints.\n\nStart with Relay: it reaches the host from anywhere. Tailscale is an optional second route for when both are on the same network — pair it too and the app falls back to it on its own.</string>
    <string name="terminal_font_size_decrease">Decrease terminal font size</string>
