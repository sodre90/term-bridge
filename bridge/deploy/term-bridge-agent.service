# systemd user unit for `term-bridge agent` on a Linux host (the counterpart
# of com.sodre90.term-bridge.plist on the Mac).
#
#   install -Dm644 term-bridge-agent.service ~/.config/systemd/user/
#   loginctl enable-linger "$USER"        # keep user services up without a login session
#   systemctl --user daemon-reload
#   systemctl --user enable --now term-bridge-agent
#   journalctl --user -u term-bridge-agent -f
#
# The agent must run as the same user as the tmux server it fronts and as
# the agents (Claude Code, ...) running inside it.
[Unit]
Description=term-bridge agent - serves this host's tmux sessions to the Term Bridge app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/bin/term-bridge agent --config %h/.config/term-bridge/agent.toml
Restart=always
RestartSec=5
# The agent logs to stderr on Linux by default; journald keeps it.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
